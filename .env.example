NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/learnsphere

# Min 16 characters each
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
OTP_SECRET=change-me-to-another-long-random-string

CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000/api

# Cloudinary (uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email OTP (set REQUIRE_EMAIL_OTP=true to enable)
REQUIRE_EMAIL_OTP=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LearnSphere <no-reply@learnsphere.com>

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe test mode (optional, needed for paid courses)
STRIPE_SECRET_KEY=

# Set true to include demo data when seeding in production
SEED_DEMO=false
# true = the 3 seeded demo accounts can log in without an email OTP (for evaluators)
DEMO_SKIP_OTP=false